# Copy to .env (git-ignored). Loaded by npm run dev:api / dev:all / start / mail:test.
# Only mail delivery needs configuring. Clinic name, phone, address and hours come
# from src/data/clinic.ts, not from here.

# --- SMTP (required to send email; leave SMTP_HOST empty to print emails to the console) ---
# Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true / SMTP_PASS = Google App Password
# Other providers (Brevo, Resend, SendGrid, Postmark, Zoho…): use their SMTP settings
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Mail routing (required) ---
# Sender shown to recipients — must be an address your provider lets you send as
MAIL_FROM="Care Dental <no-reply@example.com>"
# Clinic inbox(es) that receive booking requests, comma-separated
MAIL_TO=reception@example.com

# --- Optional overrides (defaults shown) ---
# PORT=8787                      API port
# TRUST_PROXY=false              true behind a reverse proxy so rate limiting sees real client IPs
# ALLOWED_ORIGIN=                CORS origin, only if the frontend is hosted elsewhere
# SEND_PATIENT_CONFIRMATION=true send the patient an acknowledgement email
# RATE_LIMIT_WINDOW_MINUTES=15   per-IP rate limit window
# RATE_LIMIT_MAX=5               requests per window
