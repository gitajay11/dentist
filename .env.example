# Copy to .env (git-ignored). Loaded by `node --env-file-if-exists=.env`.
# Never commit real credentials.

# --- Server ---
PORT=8787
# NODE_ENV=production
# Set to true when behind a reverse proxy so rate limiting sees the real client IP.
TRUST_PROXY=false
# Only needed if the frontend is served from a different origin than this API.
# ALLOWED_ORIGIN=https://www.clinic.example

# --- SMTP (any provider: Gmail app password, Brevo, Resend, SendGrid, Postmark, Zoho, …) ---
# Leave SMTP_HOST empty in development to print emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Mail routing ---
# Sender shown to recipients. Must be a sender your SMTP provider allows.
MAIL_FROM="[Clinic Name] <no-reply@clinic.example>"
# Clinic inbox(es) that receive appointment requests, comma-separated.
MAIL_TO=reception@clinic.example
# Send the patient an acknowledgement email (never a confirmation).
SEND_PATIENT_CONFIRMATION=true
CLINIC_NAME="Care Dental"
CLINIC_PHONE="[+91 00000 00000]"

# --- Abuse protection ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5
